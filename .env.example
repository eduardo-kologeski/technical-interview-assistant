# Copie para .env somente no ambiente local. Não versione o arquivo preenchido.
DATABASE_PASSWORD=troque-por-uma-senha-local-forte
JWT_SECRET=gere-ao-menos-64-caracteres-aleatorios-para-o-ambiente-local
JWT_REFRESH_CLEANUP_RETENTION=P30D
JWT_REFRESH_CLEANUP_INTERVAL=PT6H

# Produção (Render + Neon): configure no painel, nunca neste arquivo com valores reais.
