# Copie para .env somente no ambiente local. Não versione o arquivo preenchido.
DATABASE_PASSWORD=troque-por-uma-senha-local-forte
JWT_SECRET=gere-ao-menos-64-caracteres-aleatorios-para-o-ambiente-local
JWT_REFRESH_CLEANUP_RETENTION=P30D
JWT_REFRESH_CLEANUP_INTERVAL=PT6H
INVITATION_EXPOSE_DEVELOPMENT_LINK=false
IDENTITY_EXPOSE_DEVELOPMENT_LINK=false
DEPLOYMENT_MODE=SAAS
# Ollama roda no host; deixe OLLAMA_MODEL vazio até instalar e escolher um modelo local.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
OLLAMA_CONNECT_TIMEOUT=3s
OLLAMA_RESPONSE_TIMEOUT=60s
OLLAMA_MAX_INPUT_CHARS=120000
OLLAMA_MAX_RESPONSE_CHARS=100000
# PUBLIC_SIGNUP_ENABLED, MULTI_TENANT_ENABLED e BILLING_ENABLED usam defaults seguros do modo.
