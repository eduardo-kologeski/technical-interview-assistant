# Imagens imutáveis publicadas pelo pipeline de release. Nunca use latest em produção.
REGISTRY=ghcr.io/eduardo-kologeski
APP_VERSION=0.1.0

# Por default a aplicação só é exposta ao reverse proxy local.
LISTEN_ADDRESS=127.0.0.1
APP_PORT=8080
PUBLIC_ORIGIN=https://entrevistas.empresa.com.br

# PostgreSQL externo administrado pelo cliente.
DATABASE_URL=jdbc:postgresql://postgresql.interno:5432/interview_assistant
DATABASE_USER=
DATABASE_PASSWORD=

# Gere material aleatório forte e armazene-o no secret manager da empresa.
JWT_SECRET=
